{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/overdue-reminders", "schedule": "0 14 * * *" },
    { "path": "/api/cron/quote-followups", "schedule": "30 14 * * *" },
    { "path": "/api/cron/pending-jobs", "schedule": "0 15 * * *" },
    { "path": "/api/cron/recurring-jobs", "schedule": "0 7 * * *" },
    { "path": "/api/cron/trial-ending", "schedule": "0 16 * * *" }
  ]
}
